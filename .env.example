# این فایل را به .env کپی کنید و مقادیر را عوض کنید.
# تا وقتی change-me عوض نشود، بک‌اند عمداً بالا نمی‌آید.
POSTGRES_USER=bookstore
# رمز می‌تواند هر کاراکتری داشته باشد: openssl rand -base64 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookstore

# حداقل ۳۲ کاراکتر تصادفی: openssl rand -hex 32
SECRET_KEY=change-me

# originهای مجاز (جدا شده با کاما)
CORS_ORIGINS=http://bookstore.localhost,http://admin.bookstore.localhost

# آدرس عمومی سایت (برای canonical، sitemap و JSON-LD). در production: https://yourdomain.com
SITE_URL=http://bookstore.localhost

# فروش و پرداخت کارت‌به‌کارت (مبالغ به ریال؛ ۵۰۰٬۰۰۰ ریال = ۵۰٬۰۰۰ تومان)
SHIPPING_FEE_RIAL=500000
PAYMENT_CARD_NUMBER=6037-0000-0000-0000
PAYMENT_CARD_HOLDER=نام صاحب حساب

# کوکی ورود مشتری فقط روی HTTPS فرستاده می‌شود (Secure). تا وقتی سایت HTTPS ندارد،
# ورود مشتری روی دامنه‌ی واقعی کار نمی‌کند؛ فقط موقتاً و برای تست false کنید.
COOKIE_SECURE=true
