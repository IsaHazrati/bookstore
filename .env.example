# این فایل را به .env کپی کنید و مقادیر را عوض کنید
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookstore

# یک رشته‌ی تصادفی طولانی: openssl rand -hex 32
SECRET_KEY=change-me

# originهای مجاز (جدا شده با کاما)
CORS_ORIGINS=http://bookstore.localhost,http://admin.bookstore.localhost

# آدرس عمومی سایت (برای canonical، sitemap و JSON-LD). در production: https://yourdomain.com
SITE_URL=http://bookstore.localhost
